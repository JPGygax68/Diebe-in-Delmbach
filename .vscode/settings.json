{
    "runOnSave.commands": [
        {
            // Match scss files except names start with `_`.
            "match": "(.*\\.(html|scss))|Makefile$",
            //"notMatch": "[\\\\\\/]_[^\\\\\\/]*\\.scss$",
            "command": "make",
            "runIn": "terminal",
            "runningStatusMessage": "Making...",
            "finishStatusMessage": "Made."
        }
    ]   ,
    "files.associations": {
        "templates/*.html": "nunjucks"
    },
    "editor.defaultFormatter": "eseom.nunjucks-template",
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
}