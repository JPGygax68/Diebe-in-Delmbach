<!DOCTYPE html>
<html lang="de">
    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="./style.css">
        {% for card in cards %}
            {% if card.image %}
                <link rel="preload" as="image" href="../images/{{ card.image }}">
            {% endif %}
        {% endfor %}
        <style>
            {% for card in cards %}
                #card_{{loop.index}} .card {
                    background-image: url('../images/{{ card.image }}');
                    {% if card.image_size %}
                        background-size: {{card.image_size}};
                    {% endif %}
                }
            {% endfor %}
        </style>
    </head>
    <body>
        <div class="page front">
            {% for card in cards %}
                <div class="box" id="card_{{ loop.index }}">
                    <div class="card">
                        <div class="content">
                            <h2>{{ card.title }}</h2>
                            <p>{{ card.text }}</p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        <div class="page back">
            {% for row in [1, 2, 3] %}
                {% for col in [3, 2, 1] %}
                    {% set card = cards[(row - 1) * 3 + col - 1] %}
                    <div class="box" id="card_back_{{ (row - 1) * 3 + col }}">
                        <div class="card">
                            <div class="content">
                                {% if card.back_file %}
                                    {{ card.back_file | readmd | safe }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    </body>
</html>