<!DOCTYPE html>
<html lang="de">
    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="./style.css">
    </head>
    <body>
        <div class="page">
            {% for card in cards %}
                <div class="box">
                    <div class="card" {% if card.image %} style="background-image: url('../images/{{ card.image }}');
                                                {% if card.image_size %} background-size: {{ card.image_size }};
                                                {% endif %}" {% endif %}>
                        <div class="content">
                            <h2>{{ card.title }}</h2>
                            <p>{{ card.text }}</p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        <div class="box">
            <div class="card">
                <div class="content">
                    <h2>{{ title }}</h2>
                    <p>{{ text }}</p>
                </div>
            </div>
        </div>
    </body>
</html>